#!/usr/bin/env bash
# ABOUTME: Parses one app-status JSON object into a lifecycle-ready state.
# ABOUTME: Accepts legacy Realtime-connected or healthy wake-armed sleeping modes.

jq -er '
    if has("connected") and .connected == true then "connected"
    elif has("connected") and .connected == false
        and has("presence") and .presence == "sleeping"
        and has("wake_latched") and .wake_latched == true
        and has("wake_latch_reason") and .wake_latch_reason == "noise_bail"
        and has("last_error") and .last_error == null then "latched"
    elif has("connected") and .connected == false
        and has("presence") and .presence == "sleeping"
        and has("wake_latched") and .wake_latched == false
        and has("wake_latch_reason") and .wake_latch_reason == null
        and has("last_error") and .last_error == null then "sleeping"
    else empty
    end
'
